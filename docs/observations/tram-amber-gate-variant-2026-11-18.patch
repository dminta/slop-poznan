+test('amber is judged by the complex gate, and an amber entry commits the tram', () => {
+  let phase = 'amber';
+  const { createTramSystem } = load(() => phase, true);
+  const n = { x: 980, z: 0, in: [], out: [] };
+  const e = roadEdge(0, 980, -30, 0, 1, 28, [0]);
+  const f = roadEdge(1, 980, 2, 0, 1, 28, [0]);
+  e.to = n;
+  e.moves = [{ to: f, turn: 'S', out: [0] }];
+  n.in.push(e);
+  const signal = { x: 1010, z: 0, signal: true, in: [{ dx: 1, dz: 0, axisIndex: 0, sx: 980, sz: 0, len: 20 }] };
+  const network = {
+    nodes: [n, signal], edges: [],
+    connector: () => ({ x0: 980, z0: -2, x3: 980, z3: 2, len: 4 }),
+    curvePoint(c, s, out) { out.x = c.x0; out.z = c.z0 + s; return out; }
+  };
+  const sys = createTramSystem(inert(), { network, rail: [tram([0, 0, 3000, 0])], stops: [] });
+  const t = sys.pool[0];
+  t.active = true;
+  t.path.reset(sys.graph.edges[0], 968, t.length + 8, () => 0);
+  t.path.extend(200, () => 0);
+  t.speed = 8;
+  t.x = 968;
+  t.z = 0;
+  let time = 0;
+  const step = () => {
+    sys.occupy(t);
+    sys.drive(t, time);
+    sys.advance(t, 1 / 30);
+    t.path.pointAt(t.path.u, t);
+    time += 1 / 30;
+  };
+  // The complex gate sits about 9.5 m ahead, over 8 m/s²·3 m/s² of braking, while the head is 21.5 m off:
+  // judged by the head the tram would hold at it, but it is already inside the gate's stopping window.
+  assert.ok(t.speed * t.speed / (2 * 3) + 1 > 9.5, 'gate distance is beyond the 3 m/s² amber budget');
+  step();
+  assert.notEqual(t.waitReason, 'signal');
+  assert.ok(t.acc > 0, 'an amber tram too close to its complex gate keeps going');
+  while (t.path.u < 980 && time < 3) step();
+  assert.ok(t.path.u >= 980, 'crosses the complex entry on amber');
+  phase = 'red';
+  for (let i = 0; i < 600; i++) step();
+  assert.ok(t.path.u - t.length > 981.5, 'the amber entry commits the tram past a later red');
+});
